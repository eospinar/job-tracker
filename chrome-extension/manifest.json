{
  "manifest_version": 3,
  "name": "Job Tracker — Capturar oferta",
  "version": "1.0.0",
  "description": "Extrae los datos de ofertas de empleo (Computrabajo, El Empleo, Michael Page, Lever, Greenhouse, Workday y más) y los guarda en tu Job Tracker.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://job-tracker-swart-theta.vercel.app/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "Guardar oferta en mi CRM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
