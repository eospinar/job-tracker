PORT=4000
# Orígenes web permitidos (separados por coma). Las extensiones chrome-extension:// siempre se permiten.
CORS_ORIGINS=http://localhost:5173
# Si se define, todas las rutas de /api/applications exigen el header  x-api-key: <valor>  (obligatoria en Vercel)
API_KEY=
# Si se define, los datos se guardan en Vercel Blob (privado) en vez de data/applications.json
BLOB_READ_WRITE_TOKEN=
